# ============================================================
# Contoh konfigurasi environment — salin ke .env.local
# ============================================================

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-20

# Token server-only. Butuh hak write untuk transaksi download.
# JANGAN pernah diberi prefix NEXT_PUBLIC_.
SANITY_API_TOKEN=your_sanity_api_token

# --- Webhook Sanity (HMAC-SHA256) ---
# Samakan dengan secret di Sanity: Project → API → Webhooks.
# Tanpa ini, /api/sanity-webhook menolak semua request (503).
SANITY_WEBHOOK_SECRET=your_webhook_secret

# --- Admin panel (/admin) ---
# Login diverifikasi di server (cookie HttpOnly), bukan di browser.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
# String acak untuk menandatangani cookie sesi, mis: `openssl rand -hex 24`
ADMIN_SESSION_SECRET=your_random_session_secret

# --- Base URL (dipakai app/sitemap.xml) ---
BASE_URL=https://yourdomain.com

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- API blog (MCP / otomasi) ---
# Header: Authorization: Bearer <BLOG_API_KEY>
BLOG_API_KEY=your_blog_api_key

# --- DeepSeek (koreksi AI di editor) ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# --- Stripe ---
STRIPE_SECRET_KEY=your_stripe_secret_key

# --- Midtrans (belum dipakai di kode saat ini) ---
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_IS_PRODUCTION=false
